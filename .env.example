WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_POOL_ACCESS_TOKEN=your_pooled_numbers_system_user_token
WHATSAPP_POOL_WABA_ID=your_whatsapp_business_account_id
# Automated pool provisioning (scripts/provision_pool_number.py) — see
# app/services/pool_provisioning.py. TWILIO_COUNTRY_CODE/PUBLIC_BASE_URL
# have sane defaults but likely need setting explicitly outside local dev.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_COUNTRY_CODE=US
PUBLIC_BASE_URL=https://apiwhatsapp.whoisladleo.dev
SECRET_KEY=generate_a_random_string_here
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_db
POSTGRES_SERVER=db
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM backend: claude (default) or muse (Meta API via OpenAI SDK).
LLM_PROVIDER=claude
MODEL_API_KEY=your_meta_model_api_key_here
TUNZAA_API_KEY=your_tunzaa_api_key
TUNZAA_SECRET_KEY=your_tunzaa_secret_key
TUNZAA_ENVIRONMENT=sandbox
WHATSAPP_REMINDER_TEMPLATE_NAME=order_reminder
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE_NAME=taskflow_login
# Must match the template's actual registered locale code in WhatsApp Manager,
# not just its display name ("English" is commonly "en", not "en_US") — a
# mismatch fails with Meta error 132001.
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# Instagram ("Taskflow - IG") — a separate Meta App from the one above, using
# Instagram API with Instagram Login (no Facebook Page involved).
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_instagram_webhook_verify_token
INSTAGRAM_REDIRECT_URI=https://your-domain/api/v1/instagram/oauth/callback
# Gates every merchant's Amara on whether they're paid up on this specific
# Product (by slug) — see app/services/subscription_access.py. Leave unset
# to disable gating entirely (nobody affected).
PLATFORM_SUBSCRIPTION_PRODUCT_SLUG=taskflow-os-subscription
# Meta Commerce catalog sync (D1 client in app/core/catalog_client.py).
# CATALOG_ACCESS_TOKEN is a business system-user token with catalog_management
# scope — see CATALOG_SETUP.md. Leave both unset to disable catalog sync.
CATALOG_ID=your_meta_commerce_catalog_id
CATALOG_ACCESS_TOKEN=your_catalog_system_user_token
