WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_POOL_ACCESS_TOKEN=your_pooled_numbers_system_user_token
WHATSAPP_POOL_WABA_ID=your_whatsapp_business_account_id
# Automated pool provisioning (scripts/provision_pool_number.py) — see
# app/services/pool_provisioning.py. TWILIO_COUNTRY_CODE/PUBLIC_BASE_URL
# have sane defaults but likely need setting explicitly outside local dev.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_COUNTRY_CODE=US
PUBLIC_BASE_URL=https://apiwhatsapp.whoisladleo.dev
SECRET_KEY=generate_a_random_string_here
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_db
POSTGRES_SERVER=db
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TUNZAA_API_KEY=your_tunzaa_api_key
TUNZAA_SECRET_KEY=your_tunzaa_secret_key
TUNZAA_ENVIRONMENT=sandbox
WHATSAPP_REMINDER_TEMPLATE_NAME=hello_world
WHATSAPP_OTP_TEMPLATE_NAME=taskflow_login
# Instagram ("Taskflow - IG") — a separate Meta App from the one above, using
# Instagram API with Instagram Login (no Facebook Page involved).
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_instagram_webhook_verify_token
INSTAGRAM_REDIRECT_URI=https://your-domain/api/v1/instagram/oauth/callback
# Facebook Login (independent alternative to WhatsApp OTP login) — lives
# under the same Meta App as Instagram, but needs its own client id/secret:
# use the actual Meta App ID/Secret from Settings > Basic, NOT the
# Instagram-specific app id/secret above (they're different identifiers on
# the same app when it uses Instagram API with Instagram Login).
FACEBOOK_APP_ID=your_meta_app_id
FACEBOOK_APP_SECRET=your_meta_app_secret
FACEBOOK_LOGIN_REDIRECT_URI=https://your-domain/api/v1/auth/facebook/callback
