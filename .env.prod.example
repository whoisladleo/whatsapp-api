# Production Environment Settings
PROJECT_NAME="WhatsApp Medium"
PORT=8001 # Port on your host machine
SECRET_KEY=generate_a_very_secure_random_string_here
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# WhatsApp API Keys
WHATSAPP_TOKEN=your_production_whatsapp_token
PHONE_NUMBER_ID=your_production_phone_number_id
WEBHOOK_VERIFY_TOKEN=your_production_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret # used to verify X-Hub-Signature-256 on inbound webhooks
WHATSAPP_POOL_ACCESS_TOKEN=your_pooled_numbers_system_user_token # used for accounts auto-assigned from the phone number pool
WHATSAPP_POOL_WABA_ID=your_whatsapp_business_account_id # WABA that pool numbers live under
TWILIO_ACCOUNT_SID=your_twilio_account_sid # sources numbers for automated pool provisioning — scripts/provision_pool_number.py
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_COUNTRY_CODE=US
PUBLIC_BASE_URL=https://apiwhatsapp.whoisladleo.dev # must be this service's real public URL — Twilio's SMS webhook has to reach it
WHATSAPP_REMINDER_TEMPLATE_NAME=your_approved_reminder_template_name # order-reminder nudges outside the 24h session window need a real approved template in production
WHATSAPP_OTP_TEMPLATE_NAME=taskflow_login # authentication-category template for login OTPs; must be approved in Meta Business Manager, falls back to plain text otherwise
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en # must match the template's actual registered locale in WhatsApp Manager (its display name "English" is commonly registered as "en", not "en_US") — a mismatch fails with Meta error 132001

# Instagram ("Taskflow - IG") — a separate Meta App from the WhatsApp one
# above, using Instagram API with Instagram Login (no Facebook Page involved)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret # separate from WHATSAPP_APP_SECRET — different Meta App
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_instagram_webhook_verify_token
INSTAGRAM_REDIRECT_URI=https://apiwhatsapp.whoisladleo.dev/api/v1/instagram/oauth/callback
FACEBOOK_APP_ID=your_meta_app_id # from Settings > Basic on the Meta App — NOT INSTAGRAM_APP_ID, that's a different id even on the same app
FACEBOOK_APP_SECRET=your_meta_app_secret
FACEBOOK_LOGIN_REDIRECT_URI=https://apiwhatsapp.whoisladleo.dev/api/v1/auth/facebook/callback
# Gates every merchant's Amara on whether they're paid up on this specific
# Product (by slug) — see app/services/subscription_access.py. Leave unset
# to disable gating entirely (nobody affected).
PLATFORM_SUBSCRIPTION_PRODUCT_SLUG=taskflow-os-subscription

# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tunzaa
TUNZAA_API_KEY=your_production_tunzaa_api_key
TUNZAA_SECRET_KEY=your_production_tunzaa_secret_key # also used to verify Tunzaa webhook X-Signature
TUNZAA_ENVIRONMENT=production

# Postgres Database (External Production DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=whatsapp_db
POSTGRES_SERVER=your-db-host.amazonaws.com # External host

# Scaling
WORKERS_PER_CORE=1
MAX_WORKERS=4
TIMEOUT=120
