# Production Environment Settings
PROJECT_NAME="WhatsApp Medium"
PORT=8001 # Port on your host machine
SECRET_KEY=generate_a_very_secure_random_string_here
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# WhatsApp API Keys
WHATSAPP_TOKEN=your_production_whatsapp_token
PHONE_NUMBER_ID=your_production_phone_number_id
WEBHOOK_VERIFY_TOKEN=your_production_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret # used to verify X-Hub-Signature-256 on inbound webhooks
WHATSAPP_POOL_ACCESS_TOKEN=your_pooled_numbers_system_user_token # used for accounts auto-assigned from the phone number pool
WHATSAPP_POOL_WABA_ID=your_whatsapp_business_account_id # WABA that pool numbers live under
TWILIO_ACCOUNT_SID=your_twilio_account_sid # sources numbers for automated pool provisioning — scripts/provision_pool_number.py
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_COUNTRY_CODE=US
PUBLIC_BASE_URL=https://apiwhatsapp.whoisladleo.dev # must be this service's real public URL — Twilio's SMS webhook has to reach it
WHATSAPP_REMINDER_TEMPLATE_NAME=your_approved_reminder_template_name # order-reminder nudges outside the 24h session window need a real approved template in production

# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tunzaa
TUNZAA_API_KEY=your_production_tunzaa_api_key
TUNZAA_SECRET_KEY=your_production_tunzaa_secret_key # also used to verify Tunzaa webhook X-Signature
TUNZAA_ENVIRONMENT=production

# Postgres Database (External Production DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=whatsapp_db
POSTGRES_SERVER=your-db-host.amazonaws.com # External host

# Scaling
WORKERS_PER_CORE=1
MAX_WORKERS=4
TIMEOUT=120
